      "id": "note16",
      "type": "text",
      "x": 40,
      "y": 500,
      "width": 756,
      "height": 18,
      "text": "Pick TCP when correctness of bytes matters; UDP when late data is worse than lost data.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pick TCP when correctness of bytes matters; UDP when late data is worse than lost data.",
      "lineHeight": 1.25,
      "baseline": 13
    }
