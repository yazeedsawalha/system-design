      "id": "note15",
      "type": "text",
      "x": 600,
      "y": 280,
      "width": 252,
      "height": 88,
      "text": "• No connection setup\n• No delivery guarantee\n• App handles loss\n• DNS, VoIP, games, QUIC base\n• Lower latency",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• No connection setup\n• No delivery guarantee\n• App handles loss\n• DNS, VoIP, games, QUIC base\n• Lower latency",
      "lineHeight": 1.25,
      "baseline": 13
    },
    {
      "angle": 0,
      "strokeColor": "#868e96",
