<mxCell id="5" value="CP&#xa;Consistency +&#xa;Partition tolerance&#xa;(refuse some requests)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEF7E0;strokeColor=#F9AB00;strokeWidth=1.5;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;shadow=1;" vertex="1" parent="1"><mxGeometry x="90" y="160" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="6" value="AP&#xa;Availability +&#xa;Partition tolerance&#xa;(serve possibly stale)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1.5;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;shadow=1;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="7" value="PACELC (else, no partition)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=#DADCE0;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;fontStyle=0;fontSize=11;fontFamily=Helvetica;fontColor=#5F6368;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="520" height="280" as="geometry"/></mxCell>
<mxCell id="8" value="PA/EL&#xa;Prefer Availability &amp;&#xa;low Latency&#xa;(eventual)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E8FD;strokeColor=#A142F4;strokeWidth=1.5;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;shadow=1;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="9" value="PC/EC&#xa;Prefer Consistency&#xa;even if higher latency" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FCE8E6;strokeColor=#D93025;strokeWidth=1.5;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;shadow=1;" vertex="1" parent="1"><mxGeometry x="880" y="160" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="10" value="Axes (not a meme):&#xa;• Partition? → choose C vs A&#xa;• Else → choose Latency vs Consistency&#xa;Examples: Dynamo-style → PA/EL · Spanner-ish → PC/EC · ZooKeeper → CP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Helvetica;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="700" height="100" as="geometry"/></mxCell>
